{
  "name": "vow-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:unit": "node --experimental-strip-types --no-warnings --test tests/unit/*.test.ts",
    "contrast": "node scripts/contrast.mjs",
    "content-check": "node scripts/content-check.mjs",
    "test:e2e": "playwright test --grep-invert shots",
    "shots": "playwright test screenshots",
    "lighthouse": "lhci autorun",
    "verify": "npm run contrast && npm run test:unit && npm run check && npm run build && npm run content-check && npm run confirm-report && npm run test:e2e",
    "confirm-report": "node scripts/confirm-report.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
