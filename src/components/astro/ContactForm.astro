---
// LeadForm with the site-wide settings filled in (key, redirect, phone, email, privacy link).
import LeadForm, { type ConsignTypeOption, type FormKind, type ServiceOption } from '../islands/LeadForm';
import business from '../../data/business.json';
import { routeExists } from '../../lib/site';

interface Props {
  kind: FormKind;
  subject: string;
  services?: ServiceOption[];
  consignTypes?: ConsignTypeOption[];
  preset?: { type?: string; removal?: boolean };
  submitLabel?: string;
}
const p = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
---
<LeadForm client:visible {...p} accessKey={accessKey} subject={`Website: ${p.subject}`}
  redirectUrl={new URL('/thanks', import.meta.env.PUBLIC_SITE_ORIGIN || Astro.site).href} phoneDisplay={business.phones.main}
  email={business.email ?? undefined} siblingName={business.sibling.name}
  privacyHref={routeExists('/privacy') ? '/privacy' : undefined} />
