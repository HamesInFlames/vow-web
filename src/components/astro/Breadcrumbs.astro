---
// Hierarchical breadcrumbs on every inner page (plan §1 row 10). Last item is the current page.
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="wrap pt-5 print:hidden">
  <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 p-0 text-[0.9375rem]">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i < items.length - 1
          ? <><a href={it.path} class="tap">{it.name}</a><span aria-hidden="true" class="text-slate-60">›</span></>
          : <span aria-current="page" class="text-slate-60">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
