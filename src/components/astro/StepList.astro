---
// Numbered steps (claims, pick-up, parts). A step list that isn't confirmed yet renders only in review builds,
// with one [confirm] chip for the whole list.
import { REVIEW } from '../../lib/site';
import Confirm from './Confirm.astro';

interface Props { steps: { title: string; text: string }[]; confirm?: string; headingLevel?: 'h3' | 'h4' }
const { steps, confirm, headingLevel: H = 'h3' } = Astro.props;
const show = !confirm || REVIEW;
---
{show && (
  <div>
    {confirm && <p class="m-0 mb-2"><Confirm note={confirm} /></p>}
    <ol class="m-0 grid list-none gap-4 p-0">
      {steps.map((s, i) => (
        <li class="flex gap-4">
          <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ink font-[family-name:var(--font-display)] text-[1.25rem] font-bold text-white">{i + 1}</span>
          <div>
            <H class="m-0 text-[1.375rem]"><span class="sr-only">Step {i + 1}: </span>{s.title}</H>
            <p class="m-0 mt-1">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
)}
