---
// Sticky bottom bar on phones and tablets (plan §1 row 7): Call · Text · Directions · Book.
// Text shows only when a text-capable line is confirmed; Book only once that page exists.
import business from '../../data/business.json';
import { telHref, smsHref } from '../../lib/format';
import { routeExists } from '../../lib/site';

const items = [
  { label: 'Call', href: telHref(business.phones.main), icon: 'call' },
  ...(business.phones.sms ? [{ label: 'Text', href: smsHref(business.phones.sms), icon: 'text' }] : []),
  { label: 'Directions', href: business.address.mapsUrl, icon: 'map', external: true },
  ...(routeExists('/book') ? [{ label: 'Book', href: '/book', icon: 'list' }] : []),
];
const icons: Record<string, string> = {
  call: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z',
  text: 'M4 4h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H8l-4 4V5a1 1 0 0 1 1-1z',
  map: 'M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z',
  list: 'M4 6h16M4 12h16M4 18h16',
};
---
<nav aria-label="Quick actions" class="print:hidden lg:hidden fixed inset-x-0 bottom-0 z-30 bg-white border-t border-rule shadow-[0_-2px_8px_rgb(0_0_0/0.12)] pb-[env(safe-area-inset-bottom)]">
  <ul class="grid list-none m-0 p-0" style={`grid-template-columns: repeat(${items.length}, minmax(0, 1fr))`}>
    {items.map((item, i) => (
      <li>
        <a href={item.href}
          class:list={['flex min-h-14 flex-col items-center justify-center gap-0.5 text-[0.9375rem] font-semibold no-underline',
            i === 0 ? 'bg-red text-white hover:text-white' : 'text-ink hover:text-red']}
          {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill={item.icon === 'list' ? 'none' : 'currentColor'}
            stroke={item.icon === 'list' ? 'currentColor' : 'none'} stroke-width="2.25" stroke-linecap="round">
            <path d={icons[item.icon]} />
          </svg>
          {item.label}{item.external && <span class="sr-only"> (opens Google Maps in a new tab)</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>
