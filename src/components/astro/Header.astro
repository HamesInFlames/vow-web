---
// Site header (plan §3b). `interim` shows only the logo and the Call button.
// Nav links render only for routes that exist, so no phase ships a dead link.
import { Image } from 'astro:assets';
import logo from '../../assets/brand/vow-logo.png';
import business from '../../data/business.json';
import { telHref } from '../../lib/format';
import { builtNav, primaryNav, routeExists, type NavItem } from '../../lib/site';

interface Props { variant?: 'full' | 'interim'; current?: string }
const { variant = 'full', current = '' } = Astro.props;
const nav = variant === 'full' ? builtNav(primaryNav) : [];
// One top-level item is marked current: the one whose own page this is, else the last panel listing it
// (a page in two panels, like park home removal, belongs to the later, more specific one: Sell or consign).
const currentItem = nav.find((n) => n.href === current) ?? nav.findLast((n) => n.children?.some((c) => c.href === current));
const isCurrent = (n: NavItem) => n === currentItem;
const showBook = variant === 'full' && routeExists('/book');
---
<header class="relative z-40 bg-white border-b border-rule">
  <div class="wrap flex items-center gap-3 py-2.5 lg:py-3 xl:gap-4">
    <!-- The badge's own lettering is too small to read at header size, so the name is set beside it in text. -->
    <a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3 lg:shrink-0 rounded-sm text-ink no-underline hover:text-ink" aria-label={`${business.brandName} home`}>
      <Image src={logo} alt="" width={64} height={61}
        densities={[1, 2]} loading="eager" fetchpriority="high" class="h-12 w-auto xl:h-16" />
      <span class="leading-none" aria-hidden="true">
        <span class="block font-[family-name:var(--font-display)] text-[1.25rem] font-bold leading-[1.05] sm:text-[1.375rem] xl:text-[1.75rem]">{business.brandName}</span>
        <span class="mt-1 hidden text-[0.9375rem] text-slate-60 sm:block">RV service and parts</span>
      </span>
    </a>

    {nav.length > 0 && (
      <nav aria-label="Main" class="hidden lg:block ml-2 xl:ml-4 print:hidden">
        <ul class="flex items-center gap-0.5 list-none m-0 p-0 xl:gap-1">
          {nav.map((item) => (
            <li class="relative">
              {item.children && item.children.length > 1 ? (
                <details class="nav-panel group/panel">
                  <summary class:list={['flex min-h-12 cursor-pointer list-none items-center gap-1 whitespace-nowrap rounded px-1.5 font-semibold xl:px-3 text-ink hover:bg-paper hover:text-red [&::-webkit-details-marker]:hidden',
                    { 'text-red underline decoration-2 underline-offset-8': isCurrent(item) }]}>
                    {item.label}<span aria-hidden="true" class="hidden text-sm transition-transform group-open/panel:rotate-180 xl:inline">▾</span>
                  </summary>
                  <ul class="absolute left-0 top-full z-50 m-0 mt-1 min-w-64 list-none rounded border border-rule bg-white p-2 shadow-[0_8px_16px_rgb(0_0_0/0.15)]">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class="flex min-h-11 items-center rounded px-3 font-semibold text-ink no-underline hover:bg-paper hover:text-red"
                          aria-current={current === c.href ? 'page' : undefined}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.children?.[0]?.href ?? item.href}
                  class:list={['flex min-h-12 items-center whitespace-nowrap rounded px-1.5 font-semibold xl:px-3 text-ink no-underline hover:bg-paper hover:text-red',
                    { 'text-red underline decoration-2 underline-offset-8': isCurrent(item) }]}
                  aria-current={current === item.href ? 'page' : undefined}
                  {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  {item.label}{item.external && <span class="sr-only"> ({item.note}, opens in a new tab)</span>}
                  {item.external && <span aria-hidden="true" class="ml-1 text-slate-60">↗</span>}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="ml-auto flex items-center gap-2 print:hidden">
      <!-- Phones: Call is the main button (Book is in the sticky bar). Desktop: phone number, then Book service. -->
      <a href={telHref(business.phones.main)} class="btn btn-primary px-4 lg:hidden">Call</a>
      <!-- Below 1536 px: "Call" only (the number is in the utility row right above), so the nav fits on one line. -->
      <a href={telHref(business.phones.main)} class:list={['btn hidden gap-0 whitespace-nowrap px-4 tabular lg:inline-flex', showBook ? 'btn-secondary' : 'btn-primary']}>
        Call<span class="ml-[0.3em] hidden 2xl:inline">{business.phones.main}</span>
      </a>
      {showBook && (
        <a href="/book" class="btn btn-primary hidden whitespace-nowrap px-4 lg:inline-flex" aria-current={current === '/book' ? 'page' : undefined}>Book service</a>
      )}
      {nav.length > 0 && (
        <details class="lg:hidden group" data-phone-menu>
          <summary class="btn btn-secondary list-none cursor-pointer px-3 [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
          </summary>
          <nav aria-label="Main menu" class="absolute inset-x-0 top-full z-40 max-h-[calc(100dvh-7rem)] overflow-y-auto bg-white border-y border-rule shadow-[0_8px_16px_rgb(0_0_0/0.15)]">
            <ul class="list-none m-0 p-0">
              {nav.map((item) => (
                <li class="border-b border-rule">
                  <a href={item.children?.[0]?.href ?? item.href} class="wrap flex min-h-14 items-center text-lg font-semibold text-ink no-underline"
                    {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
                    {item.label}{item.external && <span class="ml-2 text-base font-normal text-slate-60">({item.note})</span>}
                  </a>
                  {item.children && item.children.length > 1 && (
                    <ul class="m-0 list-none pb-2 pl-0">
                      {item.children.filter((c) => c.href !== (item.children?.[0]?.href)).map((c) => (
                        <li><a href={c.href} class="wrap flex min-h-12 items-center pl-8 text-ink no-underline">{c.label}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
            <div class="wrap grid gap-3 py-6">
              <a href={telHref(business.phones.main)} class="btn btn-primary w-full text-lg tabular">Call {business.phones.main}</a>
              {showBook && <a href="/book" class="btn btn-secondary w-full text-lg">Book service</a>}
            </div>
          </nav>
        </details>
      )}
    </div>
  </div>
</header>

<script>
  // Desktop menu panels: only one open at a time; Escape or a click outside closes them.
  const panels = [...document.querySelectorAll<HTMLDetailsElement>('details.nav-panel')];
  const closeAll = (except?: HTMLDetailsElement) => panels.forEach((d) => { if (d !== except) d.open = false; });
  panels.forEach((d) => d.addEventListener('toggle', () => { if (d.open) closeAll(d); }));
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('details.nav-panel')) closeAll(); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = panels.find((d) => d.open);
    if (open) { open.open = false; open.querySelector('summary')?.focus(); }
  });
</script>
