---
// Home (plan §3b). Each section renders only once its page exists (routeExists) or its facts are confirmed.
import Base from '../layouts/Base.astro';
import HoursTable from '../components/astro/HoursTable.astro';
import Placeholder from '../components/astro/Placeholder.astro';
import Claim from '../components/astro/Claim.astro';
import RatingLine from '../components/astro/RatingLine.astro';
import ServiceTile from '../components/astro/ServiceTile.astro';
import ReviewQuote from '../components/astro/ReviewQuote.astro';
import claims from '../data/claims.json';
import reviews from '../data/reviews.json';
import business from '../data/business.json';
import { telHref } from '../lib/format';
import { REVIEW, routeExists } from '../lib/site';
import { visibleServices, bookHref, serviceHref } from '../lib/services';

const d = business;
const services = await visibleServices();
const canBook = routeExists('/book');
const month = new Date().getMonth(); // 0 = January
const winter = month >= 8 && month <= 10 ? services.find((s) => s.data.season === 'fall') : undefined;
// The strip only renders when it has something confirmed (or in a review build).
const hasClaims = routeExists('/insurance-claims');
const hasWarranty = routeExists('/warranty');
const hasParts = routeExists('/parts');
const hasPickup = routeExists('/pick-up-and-delivery');
const showReviews = reviews.items.length > 0 && (reviews.confirmed || REVIEW);
const showStrip = REVIEW || d.google.confirmed || claims.items.some((c) => c.id === 'pickup' && c.confirmed);
---
<Base title={d.brandName}>
  <!-- 1 Hero. No confirmed shop photo yet (plan V11), so the photo slot is an honest placeholder. -->
  <section aria-labelledby="hero-h" class="wrap grid items-center gap-10 py-10 lg:grid-cols-12 lg:py-16">
    <div class="lg:col-span-6">
      <p class="eyebrow m-0 text-red">Service · Parts · Warranty · Insurance claims</p>
      <span class="rule-accent mb-5 mt-3" aria-hidden="true"></span>
      <h1 id="hero-h" class="m-0 text-[2.5rem] lg:text-[3.5rem]">RV repair, parts and insurance claims in Concord</h1>
      <p class="mt-5 max-w-[34rem] text-lead">
        RVs and trailers: repairs, maintenance, winterizing and parts, at 1841 Hwy 7. Call us and tell us what’s wrong.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        {canBook && <a href="/book" class="btn btn-primary min-h-14 px-6 text-lg">Book service</a>}
        <a href={telHref(d.phones.main)} class:list={['btn min-h-14 px-6 text-lg tabular', canBook ? 'btn-secondary' : 'btn-primary']}>Call {d.phones.main}</a>
      </div>
    </div>
    <div class="lg:col-span-6">
      <Placeholder what="a service bay with an RV inside" ratio="16 / 10" />
    </div>
  </section>

  <!-- 2 Rating line and the pick-up claim (each shown only once confirmed). -->
  {showStrip && (
    <section aria-label="At a glance" class="border-t border-rule bg-white">
      <div class="wrap flex flex-wrap items-center gap-x-8 gap-y-1 py-3">
        <RatingLine />
        <Claim id="pickup" />
      </div>
    </section>
  )}

  <!-- 3 Service tiles (only services with pages). -->
  <section aria-labelledby="work-h" class="border-y border-rule bg-paper">
    <div class="wrap py-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="work-h" class="m-0 text-[2rem] lg:text-[2.5rem]">What we work on</h2>
          <span class="rule-accent mt-2" aria-hidden="true"></span>
        </div>
        <a href="/services" class="tap font-semibold">All services</a>
      </div>
      <ul class="m-0 mt-6 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => <ServiceTile service={s} />)}
      </ul>
      <ul class="m-0 mt-6 list-none space-y-1 p-0">
        <Claim id="spanish" as="li" />
      </ul>
      <p class="mb-0 mt-6">Not on the list? Call <a href={telHref(d.phones.main)} class="font-semibold tabular">{d.phones.main}</a> and ask.</p>
    </div>
  </section>

  <!-- 4 Winterizing band, in season (Sept–Nov at build time; spring swaps in once spring packages exist, plan V7). -->
  {winter && (
    <section aria-labelledby="winter-h" class="wrap grid items-center gap-8 py-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow m-0 text-red">This fall</p>
        <h2 id="winter-h" class="m-0 mt-2 text-[2rem] lg:text-[2.5rem]">Winterize before the first hard frost</h2>
        <p class="mt-4 max-w-[38rem] text-lead">{winter.data.summary}</p>
        <ul class="m-0 mt-4 list-disc space-y-1 pl-6">
          {winter.data.includes.map((i) => <li>{i}</li>)}
        </ul>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={bookHref(winter)} class="btn btn-primary text-lg">Book winterizing</a>
          <a href={serviceHref(winter)} class="btn btn-secondary">What’s included</a>
        </div>
      </div>
      <div class="lg:col-span-5"><Placeholder what={winter.data.photo} /></div>
    </section>
  )}

  <!-- 5 Insurance claims and warranty, side by side. -->
  {(hasClaims || hasWarranty) && (
    <section aria-label="Insurance claims and warranty" class="border-y border-rule bg-white">
      <div class="wrap grid gap-6 py-14 md:grid-cols-2">
        {hasClaims && (
          <div class="flex flex-col rounded border border-rule bg-paper p-6">
            <h2 class="m-0 text-[1.75rem] lg:text-[2rem]">Damage from a storm or a collision?</h2>
            <p class="mt-3 flex-1">We inspect the RV, write the estimate for your insurer with photos and a parts list, and do the repair.</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href="/insurance-claims" class="btn btn-primary">Insurance claims</a>
              <a href="/insurance-claims#claim-form" class="btn btn-secondary">Tell us about the damage</a>
            </div>
          </div>
        )}
        {hasWarranty && (
          <div class="flex flex-col rounded border border-rule bg-paper p-6">
            <h2 class="m-0 text-[1.75rem] lg:text-[2rem]">Under warranty?</h2>
            <p class="mt-3 flex-1">Bring your warranty paperwork when you book. We also offer Global Warranty extended plans.</p>
            <div class="mt-4"><a href="/warranty" class="btn btn-secondary">Warranty repairs and plans</a></div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 6 Parts and 7 pick-up. -->
  {(hasParts || hasPickup) && (
    <section aria-label="Parts and pick-up" class="wrap grid gap-10 py-14 md:grid-cols-2">
      {hasParts && (
        <div>
          <h2 class="m-0 text-[1.75rem] lg:text-[2rem]">Need a part?</h2>
          <span class="rule-accent mb-4 mt-2" aria-hidden="true"></span>
          <p class="m-0">Tell us the part and your RV’s year, make and model. We call back with the price and when we can have it.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            {routeExists('/parts/request') && <a href="/parts/request" class="btn btn-primary">Request a part</a>}
            <a href="/parts" class="btn btn-secondary">About parts</a>
          </div>
        </div>
      )}
      {hasPickup && (
        <div>
          <h2 class="m-0 text-[1.75rem] lg:text-[2rem]">Can’t tow it in?</h2>
          <span class="rule-accent mb-4 mt-2" aria-hidden="true"></span>
          <p class="m-0">We can pick up your trailer and bring it to the shop. A pick-up fee applies; we tell you the cost when we confirm.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="/pick-up-and-delivery" class="btn btn-secondary">How pick-up works</a>
          </div>
        </div>
      )}
    </section>
  )}

  <!-- 8 Real Google reviews, once picked and OK'd (reviews.json). -->
  {showReviews && (
    <section aria-labelledby="rev-h" class="border-t border-rule bg-paper">
      <div class="wrap py-14">
        <h2 id="rev-h" class="m-0 text-[2rem] lg:text-[2.5rem]">What customers say</h2>
        <div class="mt-2"><RatingLine /></div>
        <ul class="m-0 mt-6 grid list-none gap-6 p-0 md:grid-cols-3">
          {reviews.items.slice(0, 3).map((r) => <ReviewQuote review={r} />)}
        </ul>
      </div>
    </section>
  )}

  <!-- 9 Sales cross-band to RV Farm, same lot. -->
  <section aria-labelledby="rvf-h" class="bg-slate text-mist">
    <div class="wrap flex flex-wrap items-center justify-between gap-6 py-10">
      <div class="max-w-[40rem]">
        <h2 id="rvf-h" class="m-0 text-[1.75rem] text-white">Looking for a trailer? {d.sibling.name} is next door</h2>
        <p class="mt-2">{d.sibling.name} sells used trailers and park models at the same address.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={telHref(d.sibling.phone)} class="btn border-2 border-white text-white hover:bg-white/10 hover:text-white tabular">Call sales {d.sibling.phone}</a>
        <a href={d.sibling.url} target="_blank" rel="noopener" class="btn bg-white text-ink hover:bg-paper hover:text-ink">See RV Farm<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <!-- 10 Visit: address, hours, map link. -->
  <section aria-labelledby="visit-h" class="wrap grid gap-10 py-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 id="visit-h" class="m-0 text-[2rem]">Find the shop</h2>
      <span class="rule-accent mb-4 mt-2" aria-hidden="true"></span>
      <address class="not-italic text-lead">{d.address.street}<br />{d.address.city}, {d.address.region} {d.address.postal}</address>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={d.address.mapsUrl} target="_blank" rel="noopener" class="btn btn-primary">Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span></a>
        <a href={telHref(d.phones.main)} class="btn btn-secondary tabular">Call {d.phones.main}</a>
      </div>
    </div>
    <div class="lg:col-span-3"><HoursTable /></div>
    <div class="lg:col-span-4"><Placeholder what="the shop from Hwy 7" /></div>
  </section>
</Base>
