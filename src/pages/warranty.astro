---
// Warranty (plan V6). The Global Warranty plan VOW sells (Rae, Oct 8, vault 96a §1.12): $2,495, up to 3 years, no
// tires, $200 deductible, Global Warranty approves every plan (up to 30 business days). Provider PDFs linked, brochure
// text not reproduced. Warranty repair is "N/A, revisit" (Rae, Oct 8), so that section and the old site's cargo
// trailer plans are review-only.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/astro/PageIntro.astro';
import Confirm from '../components/astro/Confirm.astro';
import business from '../data/business.json';
import { formatCad, telHref } from '../lib/format';
import { warranty } from '../lib/warranty';
import { breadcrumbJsonLd } from '../lib/seo';
import { REVIEW, routeExists } from '../lib/site';

const d = business;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Warranty', path: '/warranty' }];
// Plan names as the current Warranty page lists them (docs/site-capture, "Warranty Repair").
const plans = [
  { name: 'Global Warranty for motorized RVs', href: 'https://assets.globalwarranty.com/media/global-warranty-motorized.pdf' },
  { name: 'Global Warranty for towable (non-motorized) RVs and trailers', href: 'https://assets.globalwarranty.com/media/global-warranty-non-motorized.pdf' },
];
const trailerPlans = ['Platinum cargo and utility trailer coverage', 'Gold cargo and utility trailer coverage', 'Commercial use coverage (optional)', 'Tire and wheel protection'];
---
<Base title="Warranty" current="/warranty" jsonLd={[breadcrumbJsonLd(crumbs)]}
  description={`Global Warranty extended plans for your RV from Vacations on Wheels, Concord: ${formatCad(warranty.priceCad)} for up to ${warranty.years} years.`}>
  <PageIntro title="Extended warranty plans" crumbs={crumbs}
    lead="Protect your RV after you buy it: we offer extended warranty plans from Global Warranty." />

  <div class:list={["wrap grid gap-6 pb-14 pt-6", REVIEW ? "lg:grid-cols-2" : "lg:grid-cols-[minmax(0,52rem)]"]}>
    <section aria-labelledby="plans-h" class="rounded border border-rule bg-white p-6">
      <p class="eyebrow m-0 text-red">Want more cover?</p>
      <h2 id="plans-h" class="m-0 mt-1 text-[1.75rem] lg:text-[2rem]">Global Warranty extended plan</h2>
      <p class="m-0 mt-3 text-[1.5rem] font-bold text-ink" data-warranty-price>{formatCad(warranty.priceCad)} plus HST, for up to {warranty.years} years</p>
      <ul class="m-0 mt-4 list-disc space-y-1 pl-6">
        <li>{formatCad(warranty.deductibleCad)} deductible per claim</li>
        <li>Tires are not covered</li>
        <li>Every plan has to be approved by Global Warranty. Approval can take up to {warranty.approvalBusinessDays} business days.</li>
      </ul>
      <p class="mt-4">What the plan covers depends on your RV, and Global Warranty’s own terms apply. The provider’s plan details:</p>
      <ul class="m-0 mt-2 list-none space-y-1 p-0">
        {plans.map((p) => (
          <li><a href={p.href} target="_blank" rel="noopener" class="tap">{p.name} (PDF)<span class="sr-only">, opens in a new tab</span></a></li>
        ))}
      </ul>
      {REVIEW && (
        <>
          <p class="mt-4">For cargo and utility trailers we also offer:<Confirm note="The old site's cargo and utility trailer plans (Platinum, Gold, commercial use, tire and wheel): still offered? Not answered Oct 8" /></p>
          <ul class="m-0 mt-2 list-disc space-y-1 pl-6">
            {trailerPlans.map((p) => <li>{p}</li>)}
          </ul>
        </>
      )}
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={telHref(d.phones.main)} class="btn btn-primary tabular">Call {d.phones.main}</a>
      </div>
    </section>

    {REVIEW && (
      <section aria-labelledby="repair-h" class="rounded border border-rule bg-white p-6">
        <p class="eyebrow m-0 text-red">Already covered?</p>
        <h2 id="repair-h" class="m-0 mt-1 text-[1.75rem] lg:text-[2rem]">Warranty repairs<Confirm note="Warranty repair: N/A, revisit (Rae, Oct 8). Hidden until VOW offers it; which makers (Dometic?)" /></h2>
        <p class="mt-3">If your RV, or a part in it, is still under its maker’s warranty or an extended plan, tell us when you book and bring your warranty paperwork or plan number.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          {routeExists('/book') && <a href="/book" class="btn btn-primary">Book a repair</a>}
        </div>
      </section>
    )}
  </div>
</Base>
