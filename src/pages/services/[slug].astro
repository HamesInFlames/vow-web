---
// One page per service (plan §1 row 4): what's included, price line, what to bring, FAQs, related, book.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/astro/PageIntro.astro';
import Placeholder from '../../components/astro/Placeholder.astro';
import Confirm from '../../components/astro/Confirm.astro';
import ServiceTile from '../../components/astro/ServiceTile.astro';
import Claim from '../../components/astro/Claim.astro';
import business from '../../data/business.json';
import { priceLine, telHref } from '../../lib/format';
import { breadcrumbJsonLd } from '../../lib/seo';
import { visibleServices, visibleFaq, bookHref, type Service } from '../../lib/services';

export const getStaticPaths = (async () => {
  const services = await visibleServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service, all: services } }));
}) satisfies GetStaticPaths;

interface Props { service: Service; all: Service[] }
const { service: s, all } = Astro.props;
const d = s.data;
const faq = visibleFaq(s);
const related = d.related
  .map((r) => all.find((x) => x.id === r.id))
  .filter((x): x is Service => Boolean(x));
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: d.name, path: `/services/${s.id}` },
];
const faqLd = faq.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }]
  : [];
---
<Base title={d.name} description={d.summary} current="/services" jsonLd={[breadcrumbJsonLd(crumbs), ...faqLd]}>
  <PageIntro title={d.name} crumbs={crumbs} eyebrow="Service" lead={d.summary}>
    {!d.confirmed && <p class="mt-3"><Confirm note="Service not on the current site; hidden in production until Paul confirms it" /></p>}
  </PageIntro>

  <div class="wrap grid gap-10 pb-14 pt-6 lg:grid-cols-12">
    <div class="space-y-10 lg:col-span-7">
      <section aria-labelledby="inc-h">
        <h2 id="inc-h" class="m-0 text-[1.75rem] lg:text-[2rem]">What’s included</h2>
        <ul class="m-0 mt-4 list-none space-y-2 p-0">
          {d.includes.map((i) => (
            <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 block size-2 shrink-0 bg-accent"></span><span>{i}</span></li>
          ))}
        </ul>
      </section>

      {d.bring.length > 0 && (
        <section aria-labelledby="bring-h">
          <h2 id="bring-h" class="m-0 text-[1.75rem] lg:text-[2rem]">What to bring</h2>
          <ul class="m-0 mt-4 list-disc space-y-1 pl-6">
            {d.bring.map((b) => <li>{b}</li>)}
          </ul>
        </section>
      )}

      {faq.length > 0 && (
        <section aria-labelledby="faq-h">
          <h2 id="faq-h" class="m-0 text-[1.75rem] lg:text-[2rem]">Questions people ask</h2>
          <div class="mt-4 divide-y divide-rule border-y border-rule">
            {faq.map((f) => (
              <details class="group">
                <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
                  <span>{f.q}{f.confirm && <Confirm note={f.confirm} />}</span>
                  <span aria-hidden="true" class="text-2xl leading-none text-red transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mb-4 mt-0 max-w-[44rem]">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="lg:col-span-5" aria-label="Price and booking">
      <div class="rounded border border-rule bg-white p-5 lg:sticky lg:top-4">
        <p class="m-0 text-[0.9375rem] font-semibold uppercase tracking-wide text-slate-60">Price</p>
        <p class="m-0 mt-1 text-[1.5rem] font-bold text-ink">{priceLine(d.fromPriceCad, d.priceNote)}</p>
        {!d.fromPriceCad && <p class="m-0 mt-1">We look at your RV first, then tell you the cost.</p>}
        {d.turnaround && <p class="m-0 mt-3"><span class="font-semibold text-ink">Usually takes:</span> {d.turnaround}</p>}
        <div class="mt-5 grid gap-3">
          <a href={bookHref(s)} class="btn btn-primary text-lg">Book this service</a>
          <a href={telHref(business.phones.main)} class="btn btn-secondary tabular">Call {business.phones.main}</a>
        </div>
        <ul class="m-0 mt-4 list-none space-y-1 p-0 text-[0.9375rem]">
          <Claim id="spanish" as="li" />
        </ul>
      </div>
      <div class="mt-6"><Placeholder what={d.photo} /></div>
    </aside>
  </div>

  {related.length > 0 && (
    <section aria-labelledby="rel-h" class="border-t border-rule bg-white print:hidden">
      <div class="wrap py-12">
        <h2 id="rel-h" class="m-0 text-[1.75rem] lg:text-[2rem]">Often booked with it</h2>
        <ul class="m-0 mt-6 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => <ServiceTile service={r} />)}
        </ul>
      </div>
    </section>
  )}
</Base>
