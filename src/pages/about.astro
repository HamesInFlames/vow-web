---
// About (plan §3b): confirmed facts only. The shop, its address, the lot shared with RV Farm, what it does.
// Staff, bays, years and the old site's claims are [confirm] (plan §5 #12–13). No staff names without consent.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/astro/PageIntro.astro';
import Claim from '../components/astro/Claim.astro';
import Confirm from '../components/astro/Confirm.astro';
import Placeholder from '../components/astro/Placeholder.astro';
import business from '../data/business.json';
import { telHref } from '../lib/format';
import { breadcrumbJsonLd } from '../lib/seo';
import { REVIEW, routeExists } from '../lib/site';
import { visibleServices, serviceHref } from '../lib/services';

const d = business;
const services = await visibleServices();
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About us', path: '/about' }];
const links = [
  { label: 'Reviews', href: '/reviews' },
  { label: 'Contact and directions', href: '/contact' },
].filter((l) => routeExists(l.href));
---
<Base title="About us" current="/about" jsonLd={[breadcrumbJsonLd(crumbs)]}
  description={`${d.brandName} is an RV service and parts shop at ${d.address.street}, ${d.address.city}, on the same lot as ${d.sibling.name}.`}>
  <PageIntro title="About the shop" crumbs={crumbs}
    lead={`${d.brandName} repairs and maintains RVs and trailers, and sells RV parts, at ${d.address.street} in ${d.address.city}.`} />

  <div class="wrap grid gap-10 pb-14 pt-6 lg:grid-cols-12">
    <div class="space-y-10 lg:col-span-7">
      <section aria-labelledby="do-h">
        <h2 id="do-h" class="m-0 text-[1.75rem] lg:text-[2rem]">What we do</h2>
        <ul class="m-0 mt-4 grid list-none gap-x-6 p-0 sm:grid-cols-2">
          {services.map((s) => <li><a href={serviceHref(s)} class="tap">{s.data.name}</a></li>)}
          {routeExists('/parts') && <li><a href="/parts" class="tap">Parts, in store or ordered in</a></li>}
          {routeExists('/insurance-claims') && <li><a href="/insurance-claims" class="tap">Insurance claim repairs</a></li>}
          {routeExists('/pick-up-and-delivery') && <li><a href="/pick-up-and-delivery" class="tap">Pick-up of RVs for service</a></li>}
        </ul>
      </section>

      <section aria-labelledby="lot-h">
        <h2 id="lot-h" class="m-0 text-[1.75rem] lg:text-[2rem]">Next door to {d.sibling.name}</h2>
        <p class="mt-3">We share a lot with {d.sibling.name}, which sells used trailers and park models. Two businesses, one address: buy a trailer there, and bring it to us for service.</p>
        <a href={d.sibling.url} target="_blank" rel="noopener" class="tap">Visit {d.sibling.name}<span class="sr-only"> (opens in a new tab)</span></a>
      </section>

      <section aria-labelledby="team-h">
        <h2 id="team-h" class="m-0 text-[1.75rem] lg:text-[2rem]">The team</h2>
        <ul class="m-0 mt-3 list-none space-y-1 p-0">
          <Claim id="family" as="li" />
          <Claim id="spanish" as="li" />
          <Claim id="certified" as="li" />
          <Claim id="experience" as="li" />
        </ul>
        {REVIEW && <p class="mt-3">Bays, number of technicians, years in business.<Confirm note="Staff: bays, techs, years in business, consent before naming anyone (plan §5 #13)" /></p>}
        <p class="mt-3">Questions about your RV? Call the shop at <a href={telHref(d.phones.main)} class="font-semibold tabular">{d.phones.main}</a>.</p>
      </section>

      {links.length > 0 && (
        <nav aria-label="More about us" class="flex flex-wrap gap-3">
          {links.map((l) => <a href={l.href} class="btn btn-secondary">{l.label}</a>)}
        </nav>
      )}
    </div>
    <div class="space-y-6 lg:col-span-5">
      <Placeholder what="the shop and its service bays" />
      <Placeholder what="the team at the counter" />
    </div>
  </div>
</Base>
